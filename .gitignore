# Secrets -- the JSearch API key lives here
.env
*.env
!.env.example

# test/raw_responses/ is deliberately NOT ignored. The cached payloads are the
# only evidence for the English-only sampling finding published in
# CAREER_PROJECT_SPEC.md, and for the job_country/job_location filter numbers in
# CHANGELOG.md. Regenerating them costs API quota and would not reproduce the
# same result set, so they are committed as evidence rather than as build
# output. Verified free of credentials before committing: the API key travels in
# a request header and does not appear in any response body.

# Virtualenv. This project's is deliberately outside the repo, at
# ~/.venvs/skillgap -- torch is ~2.5GB and this folder is OneDrive-synced.
# These patterns catch one created in-tree by mistake.
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local scratch from triage and migration passes
*.bak
*.csv.tmp
*.pre-triage.bak
*.pre-release.bak

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Backend runtime state: the engine cache, regenerated from the committed
# inputs it is keyed on. backend/data/ held the old server-side profile
# database; it stays ignored so a leftover copy is never committed.
backend/.cache/
backend/data/
.pytest_cache/
